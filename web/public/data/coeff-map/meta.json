      "salary_scaling": "housing-only; not full COL"
    },
    "avg_simple": {
      "label": "Average (simple)",
      "formula": "unweighted mean of available among {BEA RPP coef, ACS Rent coef, HUD FMR coef}",
      "salary_scaling": "exploratory"
    },
    "avg_weighted": {
      "label": "Average (weighted)",
      "formula": "0.50 BEA + 0.25 ACS + 0.25 HUD, weights renormalized over available inputs",
      "salary_scaling": "exploratory"
    }
  },
  "skippedIndices": {
